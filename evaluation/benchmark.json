    "page_numbering": "1-based PDF page index as returned by app.ingestion.pdf_parser (not the printed page number)",
    "evidence_groups": "Each group is one piece of evidence; any page in the group supplies it. Recall@k counts satisfied groups.",
    "documents": {
      "oecd_interim_2025_09": "evaluation/corpus/oecd_interim_2025_09.pdf",
      "ragas_2023": "evaluation/corpus/ragas_2023.pdf",
      "beir_2021": "evaluation/corpus/beir_2021.pdf"
