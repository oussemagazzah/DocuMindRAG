  },
  "categories": {
    "fact_retrieval": {
      "description": "Single fact stated on one page (or restated on a few)",
      "count": 20
    },
    "multi_hop": {
      "description": "Needs evidence from two different pages",
      "count": 10
    },
    "comparison": {
      "description": "Compares two entities or values from the documents",
      "count": 10
    },
    "unanswerable": {
      "description": "Plausible question whose answer is not in any document",
      "count": 10
    }
  },
