# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Collection
COLLECTION_NAME=documind_chunks

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LLM (Ollama fallback - used when Gemini fails)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=128
MAX_CHUNK_SIZE_TOKENS=1024

# Retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_K=5

# Database (leave DATABASE_URL empty for SQLite, set for PostgreSQL)
DATABASE_URL=
DATABASE_PATH=./documind.db

# Redis (for caching + rate limiting)
REDIS_URL=redis://localhost:6379/0

# Upload
MAX_UPLOAD_SIZE_MB=50

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# API Key auth (comma-separated keys, leave empty to disable)
API_KEYS=

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
